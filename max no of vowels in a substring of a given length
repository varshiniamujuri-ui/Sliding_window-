class Solution:
    def maxVowels(self, s: str, k: int) -> int:
        n = "aeiou"
        i = 0
        j = 0
        c = 0
        maxi = 0
        for j   in range(len(s)):
            if s[j] in n:
                c += 1
            if j - i + 1 == k:
                maxi = max(maxi, c)
                if s[i] in n:
                    c -= 1
                i += 1
        return maxi
 
       
